# Sao chép thành ~/vocrecord/.env trên VPS (cạnh docker-compose.prod.yml). KHÔNG commit file thật.
DOMAIN=ngtiendat.id.vn
GHCR_OWNER=tdat2005
IMAGE_TAG=latest
# Mật khẩu root MySQL: chuỗi ngẫu nhiên dài, ví dụ tạo bằng: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=doi-mat-khau-nay
# User MySQL riêng cho API (chỉ đọc/ghi dữ liệu, không có quyền root). Nên đặt cả hai dòng.
# Chỉ dùng chữ, số, dấu _ . -  Tạo mật khẩu bằng: openssl rand -hex 24
# Bỏ dấu # ở cả hai dòng khi dùng; đặt một dòng mà thiếu dòng kia thì API không kết nối được CSDL.
# Để nguyên (có dấu #) thì API dùng tài khoản root như trước.
# MYSQL_APP_USER=vocrecord_app
# MYSQL_APP_PASSWORD=
