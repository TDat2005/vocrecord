# Sao chép thành ~/vocrecord/deploy/server.env trên VPS. KHÔNG commit file thật.
# (DB_* do docker-compose.prod.yml tự truyền vào)

# Chuỗi bí mật ký JWT: tạo bằng  openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=https://ngtiendat.id.vn,https://www.ngtiendat.id.vn

# Email (Gmail: dùng App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Voc Records

# PayOS (lấy ở my.payos.vn). Webhook khai báo trên PayOS: https://ngtiendat.id.vn/api/payos/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://ngtiendat.id.vn/payment-result
PAYOS_CANCEL_URL=https://ngtiendat.id.vn/payment-result

# GHN (để trống GHN_TOKEN nếu chưa dùng)
GHN_ENV=staging
GHN_TOKEN=
GHN_SHOP_ID=
GHN_REQUIRED_NOTE=CHOXEMHANGKHONGTHU
GHN_PAYMENT_TYPE_ID=2
GHN_FROM_NAME=Voc Records
GHN_FROM_PHONE=
GHN_FROM_ADDRESS=
GHN_FROM_WARD_NAME=
GHN_FROM_PROVINCE_NAME=
GHN_RETURN_NAME=Voc Records
GHN_RETURN_PHONE=
GHN_RETURN_ADDRESS=
GHN_RETURN_WARD_NAME=
GHN_RETURN_PROVINCE_NAME=

RETURN_WINDOW_DAYS=7
