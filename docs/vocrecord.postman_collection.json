            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": 1,\n      \"qty\": 1\n    }\n  ],\n  \"address\": \"12 Thái Hà, Hà Nội\",\n  \"nguoiNhan\": \"Khách\",\n  \"sdtNhan\": \"0912345678\",\n  \"phuongThucThanhToan\": \"cod\"\n}"
            }
          }
        },
        {
          "name": "Danh sách đơn",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Chi tiết đơn",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "1"
              ]
            }
          }
        },
        {
          "name": "Khách hủy đơn",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/1/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "1",
                "cancel"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Cập nhật trạng thái (NV/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "1",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"daxacnhan\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Quản trị",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Báo cáo doanh thu",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
