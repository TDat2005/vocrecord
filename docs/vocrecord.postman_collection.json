            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": 1,\n      \"qty\": 3,\n      \"price\": 100000\n    }\n  ],\n  \"note\": \"Nhập thêm\"\n}"
            }
          }
        },
        {
          "name": "Nhật ký hoạt động",
