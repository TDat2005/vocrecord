              ],
              "query": [
                {
                  "key": "start",
                  "value": "2026-09-01"
                },
                {
                  "key": "end",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        },
        {
          "name": "Nhập kho",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/import-stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
