{
  "info": {
    "name": "Vọc Records API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bộ request kiểm thử API Vọc Records. Đăng nhập trước để lưu token vào biến {{token}}."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Xác thực",
      "item": [
        {
          "name": "Đăng nhập (lưu token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"khachdemo\",\n  \"password\": \"Demo@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set('token', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Gửi OTP đăng ký",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/send-register-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "send-register-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ban@example.com\"\n}"
            }
          }
        },
        {
          "name": "Xác thực OTP & tạo tài khoản",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-register-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-register-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ban@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"MatKhau@123\",\n  \"fullname\": \"Họ Tên\",\n  \"phone\": \"0900000000\"\n}"
            }
          }
        },
        {
          "name": "Quên mật khẩu - gửi OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/send-forgot-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "send-forgot-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ban@example.com\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Sản phẩm",
      "item": [
        {
          "name": "Danh sách / tìm kiếm",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?search=abbey",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "abbey"
                }
              ]
            }
          }
        },
        {
          "name": "Chi tiết sản phẩm",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1"
              ]
            }
          }
        },
        {
          "name": "Danh mục",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Thêm sản phẩm (NV/Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tên album\",\n  \"artist\": \"Nghệ sĩ\",\n  \"genre\": \"Đĩa Than (Vinyl)\",\n  \"price\": 500000,\n  \"stock\": 10,\n  \"status\": \"conhang\"\n}"
            }
          }
        },
        {
          "name": "Xóa mềm sản phẩm (NV/Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Mã giảm giá",
      "item": [
        {
          "name": "Kiểm tra mã",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/discounts/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "discounts",
                "check"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME10\",\n  \"cartTotal\": 1000000\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Đơn hàng",
      "item": [
        {
          "name": "Đặt hàng COD",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
