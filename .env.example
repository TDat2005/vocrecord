# Trợ lý mua sắm AI (Claude). Để trống thì widget chat tự chuyển sang chế độ tìm kiếm thông minh.
# Lấy key tại https://platform.claude.com
ANTHROPIC_API_KEY=
# AI_CHAT_MODEL=claude-opus-5-5
# AI_CHAT_EFFORT=low

# Tìm kiếm ngữ nghĩa và tìm bằng ảnh chạy cục bộ (miễn phí), tải mô hình từ Hugging Face lần đầu.
# AI_EMBEDDINGS=off        # tắt hẳn, chỉ tìm theo từ khóa
# AI_WARMUP=off            # không tải mô hình ngay khi khởi động
# AI_TEXT_MODEL=Xenova/multilingual-e5-small
# AI_IMAGE_MODEL=Xenova/clip-vit-base-patch32
